<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Pal-Engke | Community</title>
  <link rel="icon" type="image/png" href="/images/robot-logo.ico">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles/community.css">
</head>

<body class="community-bg">
  <div class="community-container">
    <header class="community-header">
      <h3 class="fw-bold">Recipe Community</h3>
      <% if (user) { %>
        <button class="btn btn-share">+ Share Recipe</button>
      <% } else { %>
        <a href="/auth/login" class="btn btn-share">Login to Share</a>
      <% } %>
    </header>

    <section class="filters d-flex flex-wrap justify-content-center">
      <button class="btn btn-filter active">Trending</button>
      <button class="btn btn-filter">Following</button>
      <button class="btn btn-filter">Quick Meals</button>
      <button class="btn btn-filter">Budget-Friendly</button>
      <button class="btn btn-filter">Traditional</button>
    </section>

    <% recipes.forEach(r => { %>
      <section class="recipe-card shadow-sm" data-id="<%= r._id %>">
        <div class="d-flex align-items-center mb-2">
          <div>
            <% if (r.user && r.user.profile_picture) { %>
              <img src="<%= r.user.profile_picture %>" alt="avatar" style="width:40px;height:40px;border-radius:50%;object-fit:cover">
              <% } else if (r.user && r.user.firstName) { %>
                <div class="avatar">
                  <%= (r.user.firstName[0] + (r.user.lastName ? r.user.lastName[0] : '') ).toUpperCase() %>
                </div>
                <% } else { %>
                  <div class="avatar">U</div>
                  <% } %>

          </div>

          <div class="ms-2">
            <strong><%= r.user ? (r.user.firstName + (r.user.lastName ? ' ' + r.user.lastName : '')) : 'Unknown' %></strong>
            <p class="small text-muted mb-0"><%= r.createdAt.toLocaleString() %></p>
          </div>
        </div>

        <p class="post-text"><%= r.text %></p>

        <% if (r.image) { %>
          <img src="<%= r.image %>" class="img-fluid rounded mt-2 post-image" style="max-height: 350px;">
        <% } %>

        <div class="d-flex justify-content-between align-items-center mt-2">
          <div>
            <button class="btn-like" title="Like">
              <span class="like-emoji"><%= (user && r.likes && r.likes.some(l => String(l) === String(user.id || user._id))) ? '💖' : '🤍' %></span>
              <span class="like-count"><%= r.likes ? r.likes.length : 0 %></span>
            </button>
          </div>

          <% if (user && String(user.id || user._id) === String(r.user ? r.user._id : '')) { %>
            <div>
              <button class="btn btn-sm btn-outline-primary btn-edit">Edit</button>
              <button class="btn btn-sm btn-outline-danger btn-delete">Delete</button>
            </div>
          <% } %>
        </div>
      </section>
    <% }) %>
  </div>

  <%- include('partials/navbar', { activePage: 'community' }) %>
  <script src="/scripts/community.js"></script>
</body>
</html>
